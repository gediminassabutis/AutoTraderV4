<Window x:Class="AutoTraderV4.WindowsDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutoTraderV4.WindowsDesktop.ViewModels"
        mc:Ignorable="d"
        Title="AutoTraderV4 Desktop" Height="900" Width="1530" WindowStartupLocation="CenterScreen" Background="#101827">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#1f2937"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="AutoTraderV4" FontSize="28" FontWeight="Bold" Foreground="#f8fafc"/>
                    <TextBlock Text="Windows Desktop UI" FontSize="14" Foreground="#cbd5e1" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1d4ed8" CornerRadius="16" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock Text="Live dashboard" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="RefreshButton" Content="Refresh" Width="100" Height="34" Background="#4f46e5" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource MutedText}" Text="Portfolio value"/>
                    <TextBlock x:Name="PortfolioValueText" Text="$0.00" FontSize="26" FontWeight="Bold" Foreground="#f8fafc" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource MutedText}" Text="Available cash"/>
                    <TextBlock x:Name="CashText" Text="$0.00" FontSize="26" FontWeight="Bold" Foreground="#f8fafc" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource MutedText}" Text="Daily P&amp;L"/>
                    <TextBlock x:Name="DailyPnLText" Text="$0.00" FontSize="26" FontWeight="Bold" Foreground="#34d399" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Style="{StaticResource MutedText}" Text="Weekly P&amp;L"/>
                    <TextBlock x:Name="WeeklyPnLText" Text="$0.00" FontSize="26" FontWeight="Bold" Foreground="#34d399" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource MutedText}" Text="Monthly P&amp;L"/>
                    <TextBlock x:Name="MonthlyPnLText" Text="$0.00" FontSize="26" FontWeight="Bold" Foreground="#34d399" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <TextBlock Style="{StaticResource MutedText}" Text="Exposure"/>
                    <TextBlock x:Name="ExposureText" Text="0.00%" FontSize="26" FontWeight="Bold" Foreground="#fbbf24" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource HeaderText}" Text="Market overview" FontSize="18"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" Text="S&amp;P 500, Nasdaq, Dow Jones, FTSE 100, VIX"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource MutedText}" FontWeight="SemiBold" VerticalAlignment="Center" Text="Loading..."/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource HeaderText}" Text="Open positions" FontSize="18"/>
                    <DataGrid x:Name="PositionsGrid" Grid.Row="1" Margin="0,12,0,0" AutoGenerateColumns="False" Background="#0f172a" Foreground="#e2e8f0" AlternatingRowBackground="#111827" GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="0.9*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="0.7*"/>
                            <DataGridTextColumn Header="Entry" Binding="{Binding EntryPrice, StringFormat=C}" Width="0.9*"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding CurrentPrice, StringFormat=C}" Width="0.9*"/>
                            <DataGridTextColumn Header="P&amp;L" Binding="{Binding UnrealizedPnl, StringFormat=C}" Width="0.9*"/>
                            <DataGridTextColumn Header="Stop" Binding="{Binding StopLoss, StringFormat=C}" Width="0.8*"/>
                            <DataGridTextColumn Header="Take" Binding="{Binding TakeProfit, StringFormat=C}" Width="0.8*"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="0.9*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource HeaderText}" Text="Watchlist" FontSize="18"/>
                    <DataGrid x:Name="WatchlistGrid" Grid.Row="1" Margin="0,12,0,0" AutoGenerateColumns="False" Background="#0f172a" Foreground="#e2e8f0" AlternatingRowBackground="#111827" GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="0.8*"/>
                            <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="1.1*"/>
                            <DataGridTextColumn Header="Forecast" Binding="{Binding ForecastReturn, StringFormat={}{0:#0.0}%}" Width="0.9*"/>
                            <DataGridTextColumn Header="Risk" Binding="{Binding RiskScore}" Width="0.7*"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="0.9*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource HeaderText}" Text="AI insights" FontSize="18"/>
                    <ItemsControl x:Name="InsightsList" Grid.Row="1" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Background="#0f172a" CornerRadius="10" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#f8fafc" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="#cbd5e1" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource HeaderText}" Text="Alerts" FontSize="18"/>
                    <ItemsControl x:Name="AlertsList" Grid.Row="1" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Background="#0f172a" CornerRadius="10" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#f8fafc" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Message}" Foreground="#cbd5e1" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Severity}" Foreground="#94a3b8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource HeaderText}" Text="Market heatmap" FontSize="18"/>
                    <ItemsControl x:Name="MarketOverviewList" Grid.Row="1" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Background="#0f172a" CornerRadius="10" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Foreground="#f8fafc" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Value}" Foreground="#cbd5e1" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ChangePercent}" Foreground="#34d399" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
